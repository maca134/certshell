{
    "name": "web-ssh",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "dev:up": "docker compose -f compose.yaml -f compose.dev.yaml up -d",
        "dev:down": "docker compose -f compose.yaml -f compose.dev.yaml down",
        "lint": "biome check",
        "format": "biome check --write",
        "typecheck": "bun run --filter '*' typecheck",
        "build": "bun run --filter web build",
        "test": "bun run --filter api --filter web test",
        "e2e": "bun run --filter web e2e"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@playwright/mcp": "0.0.83"
    }
}
