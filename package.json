{
    "name": "certshell",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "dev:up": "docker compose -f compose.yaml -f compose.dev.yaml up",
        "dev:down": "docker compose -f compose.yaml -f compose.dev.yaml down --remove-orphans",
        "lint": "biome check",
        "format": "biome check --write",
        "typecheck": "bun run --filter '*' typecheck",
        "build": "bun run --filter web build",
        "test": "bun run --filter api --filter web test && bun test ./test",
        "verify": "bun run lint && bun run typecheck && bun run build && bun run test",
        "e2e": "bun run --filter web e2e",
        "media": "bun run --filter web media"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@playwright/mcp": "0.0.83",
        "wrangler": "4.147.0"
    }
}
